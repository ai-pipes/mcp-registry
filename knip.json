{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        ".dependency-cruiser.resolve.cjs",
        "e2e/**/*.spec.ts",
        "e2e/**/playwright.config.ts"
      ],
      "project": ["scripts/**", "*.{ts,cjs,mjs}", "e2e/**/*.ts"],
      "ignoreDependencies": ["@swc/core"]
    },
    "apps/web": {
      "entry": ["src/components/ui/*.tsx", "src/lib/utils.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.{ts,tsx}", "!test/architecture/fixtures/**"],
      "ignoreIssues": {
        "src/components/ui/**": ["exports", "types"]
      }
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    }
  }
}
