# mcp-registry settings. Copy to .env and fill in: cp .env.example .env
# Optional lines are commented out; an empty value (KEY=) counts as unset.

# ---------- Network ----------

# Host port the server is published on (inside the container it always listens on 3000).
PORT=3000

# URL people and Claude Code use to reach the gateway (scheme + host + port). Used to build the
# `claude mcp add ... <PUBLIC_URL>/mcp` command and the OIDC/OAuth redirect URIs, and checked
# against the Origin header. Behind a reverse proxy, set the external URL.
PUBLIC_URL=http://localhost:3000

# Extra accepted Host header values for /mcp, comma-separated (no port).
# The PUBLIC_URL host, localhost and 127.0.0.1 are always accepted.
# ALLOWED_HOSTS=mcp.internal.example.com

# true: the server runs behind a reverse proxy (nginx, Traefik, Caddy) and the client IP is taken
# from X-Forwarded-For. Without a proxy keep false, or clients can spoof their IP.
TRUST_PROXY=false

# Number of trusted proxies in front of the server (1-5). Only used with TRUST_PROXY=true.
TRUST_PROXY_HOPS=1

# Secure flag of the session cookie. Keep true: it works over HTTPS and on http://localhost.
COOKIE_SECURE=true

# ---------- Database ----------

# Password of the bundled Postgres. Generate: openssl rand -base64 32
# Set it before the first start: afterwards it is stored in the pgdata volume.
POSTGRES_PASSWORD=

# Postgres connection string. By default docker-compose.yml connects to its own db container
# (postgres://mcp@db:5432/mcp, password from POSTGRES_PASSWORD). The database needs pgvector.
# DATABASE_URL=postgres://user:password@host:5432/mcp

# ---------- Secrets ----------

# AES-256-GCM key for upstream secrets and people's tokens: base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32. Back it up: losing the key loses every stored secret.
SECRETS_KEY=

# Previous key, only while rotating SECRETS_KEY: put the new key in SECRETS_KEY and the old one
# here, restart, run `node dist/cli.js rotate-secrets-key`, then remove this line and restart
# again. While set, it still opens secrets not yet re-encrypted. Must differ from SECRETS_KEY.
# SECRETS_KEY_OLD=

# ---------- Login (OIDC) ----------

# Issuer URL of your OIDC provider and the confidential client registered for the gateway
# (redirect URI: <PUBLIC_URL>/api/auth/callback, scopes: OIDC_SCOPES below).
# The provider must emit the person's groups in the OIDC_GROUPS_CLAIM claim. Discovery happens on the first login, not at startup:
# without the provider the server and /mcp still work, and login answers
# /?loginError=idp_unavailable until the provider is reachable.
# Example: OIDC_ISSUER=https://id.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Group whose members may sign in, and the admin group (its members may sign in too).
# OIDC_LOGIN_GROUP=mcp-users
# OIDC_ADMIN_GROUP=mcp-admins

# Scopes of the login request (space- or comma-separated, must include openid). Drop `groups`
# for providers that reject unknown scopes (Microsoft Entra ID, Zitadel).
# OIDC_SCOPES=openid profile email groups

# Claim (ID token or UserInfo) holding the person's groups: a list of names, or an object whose
# keys are the names. Examples: `roles` (Entra ID app roles), `https://example.com/groups`
# (Auth0 namespaced claim), `urn:zitadel:iam:org:project:roles` (Zitadel project roles).
# OIDC_GROUPS_CLAIM=groups

# ---------- Catalog, call log, upstreams ----------

# How often to synchronise the tool catalog with upstream servers, hours (1-8760).
# SYNC_INTERVAL_HOURS=6

# How many days to keep the call log.
# CALL_LOG_RETENTION_DAYS=90

# Maximum upstream response size, bytes (default 20 MiB). Protects server memory.
# UPSTREAM_MAX_RESPONSE_BYTES=20971520

# Maximum request body size for /mcp, bytes (default 10 MiB): call_tool arguments can be large
# (a file in base64). The rest of the HTTP API (/api/**) is limited to 1 MiB.
# MCP_MAX_BODY_BYTES=10485760

# ---------- Search (embeddings) ----------

# local: the bundled multilingual-e5-small model, works offline (default).
# openai-compatible: an external service with POST <EMBEDDER_URL>/embeddings
# (requires EMBEDDER_URL and EMBEDDER_MODEL).
EMBEDDER=local

# URL and model of the external embeddings service, only for EMBEDDER=openai-compatible.
# The model must produce 384-dimensional vectors.
# EMBEDDER_URL=http://embeddings.example.com:8080/v1
# EMBEDDER_MODEL=multilingual-e5-small

# Cosine-similarity floor (0-1) for vector search. Calibrated for the bundled model; lower it if
# agents miss obvious tools, raise it if they get unrelated ones. Recalibrate for another model.
# SEARCH_MIN_SIMILARITY=0.83

# Directory of the local model. The image already has it in /app/models; change only if needed.
MODEL_DIR=/app/models

# ---------- Logging ----------

# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
