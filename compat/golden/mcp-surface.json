{
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "instructions": "This server is a gateway to the user's services (git hosting, issue tracker and others). When a task needs one of them, call search_tools with a short description of the action, then describe_tool for the chosen tool, then call_tool. If nothing fits, continue without them. If a tool needs a connection, tell the user the link from the error.",
  "serverInfo": {
    "name": "mcp-registry",
    "version": "<version>"
  },
  "tools": [
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "List the user's services available through this gateway: slug, name, description, number of tools and connection state (connectUrl when the user has to connect first).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "type": "object"
      },
      "name": "list_servers",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "servers": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "connectUrl": {
                  "type": "string"
                },
                "connection": {
                  "enum": [
                    "ready",
                    "needs_connection",
                    "expired",
                    "not_required"
                  ],
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "tools": {
                  "type": "number"
                }
              },
              "required": [
                "slug",
                "name",
                "description",
                "tools",
                "connection"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "servers"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Find tools by a short description of the action. Returns only tools above a relevance threshold, best first, with score 0–1; an empty list means nothing fits. servers (slugs from list_servers) limits the search.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "default": 10,
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "servers": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "search_tools",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "annotations": {
                  "additionalProperties": {
                    "type": "boolean"
                  },
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "connection": {
                  "enum": [
                    "ready",
                    "needs_connection",
                    "expired",
                    "not_required"
                  ],
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "server": {
                  "type": "string"
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tool": {
                  "type": "string"
                }
              },
              "required": [
                "tool",
                "title",
                "description",
                "server",
                "score",
                "annotations",
                "connection"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Full description and input JSON Schema of a tool from search_tools (\"<server>.<tool>\"). Call before call_tool.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "tool": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "type": "object"
      },
      "name": "describe_tool",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "annotations": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "connection": {
            "enum": [
              "ready",
              "needs_connection",
              "expired",
              "not_required"
            ],
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "outputSchema": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "server": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "title",
          "description",
          "inputSchema",
          "annotations",
          "server",
          "connection"
        ],
        "type": "object"
      }
    },
    {
      "annotations": {
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Call a tool (\"<server>.<tool>\") with arguments matching its inputSchema, on the user's behalf. Returns the service's result as is.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "arguments": {
            "additionalProperties": {},
            "default": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "tool": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "type": "object"
      },
      "name": "call_tool"
    }
  ]
}
