{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authKind": {
      "enum": [
        "oauth_user",
        "pat_user"
      ],
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "server": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "expired",
        "missing"
      ],
      "type": "string"
    }
  },
  "required": [
    "server",
    "name",
    "authKind",
    "status"
  ],
  "type": "object"
}
