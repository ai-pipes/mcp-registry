{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "annotations": {
        "additionalProperties": false,
        "properties": {
          "destructiveHint": {
            "type": "boolean"
          },
          "idempotentHint": {
            "type": "boolean"
          },
          "openWorldHint": {
            "type": "boolean"
          },
          "readOnlyHint": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "hidden": {
        "type": "boolean"
      },
      "inputSchema": {
        "additionalProperties": {},
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "name": {
        "type": "string"
      },
      "outputSchema": {
        "anyOf": [
          {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "ref": {
        "type": "string"
      },
      "title": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "ref",
      "title",
      "description",
      "annotations",
      "name",
      "inputSchema",
      "outputSchema",
      "hidden"
    ],
    "type": "object"
  },
  "type": "array"
}
