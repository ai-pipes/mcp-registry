# The pinned native libraries of the `onnx` build: the ONE list of URLs and SHA-256 values.
# Plain NAME=value lines, read by three consumers: the Makefile (`include`), fetch.sh (`.`, so
# `make native-libs` and the Dockerfile stage `go-native` use the same script) and the Go test
# native_pins_test.go, which fails if a pin is repeated anywhere else.
# Platform keys use `_` instead of `-` (linux_arm64) so that they are valid shell names.
#
# ONNX Runtime 1.30.0, CPU: the libraries inside the npm package onnxruntime-node@1.30.0, the very
#   files the TypeScript reference image loads. The exact build is a parity condition.
# libtokenizers 1.27.0: the static library of github.com/daulet/tokenizers, release assets
#   (tarball hash, then the hash of libtokenizers.a inside it).
ORT_NPM_URL=https://registry.npmjs.org/onnxruntime-node/-/onnxruntime-node-1.30.0.tgz
ORT_NPM_SHA256=6e3390d6b783e7be946fad629292799da28d0b42f84856e50d2c1b0383291e75
TOK_BASE_URL=https://github.com/daulet/tokenizers/releases/download/v1.27.0

ORT_MEMBER_darwin_arm64=package/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib
ORT_FILE_darwin_arm64=libonnxruntime.1.30.0.dylib
ORT_SHA_darwin_arm64=685d2be5dba1309c89d3a5324b7fd06a5c42f1a61bfea32d14c4cc28d072121d
TOK_SHA_TGZ_darwin_arm64=fb84b8b2e349a5952767ffe80ccd862fc44084de47f3b0cc3f0b7c9d4e649cf7
TOK_SHA_darwin_arm64=c91ae814afb8fe4f000099972208f60c3aa2d13899a7cd5a31fee2e9e2efbac7

ORT_MEMBER_linux_arm64=package/bin/napi-v6/linux/arm64/libonnxruntime.so.1
ORT_FILE_linux_arm64=libonnxruntime.so.1
ORT_SHA_linux_arm64=1f549d46250b005580b597f4164984aaf75b3bcb9f3aeb07c7f8a8fe60b23c76
TOK_SHA_TGZ_linux_arm64=e96545ad05930c26f51f63d932ee6d3bbd32bbed149e102c5290d587a2293067
TOK_SHA_linux_arm64=aa4d3a7d28023e439fa7a645fb606195acafb5c33c8cd01928ed1aacfc4c074e

ORT_MEMBER_linux_amd64=package/bin/napi-v6/linux/x64/libonnxruntime.so.1
ORT_FILE_linux_amd64=libonnxruntime.so.1
ORT_SHA_linux_amd64=ffb75a925ba05e47b235bb66e3e3911714a80b328a9c9425539feb204aa32a23
TOK_SHA_TGZ_linux_amd64=72556cdca798dd4ea7cdaba308e5f0d68a8cb93b67c96edf485b7a0edd7b07f4
TOK_SHA_linux_amd64=e6862b31745bb7d07980fcee70e49cd3b4318097609180f5d2d3fb394f305d50

# The embedding model Xenova/multilingual-e5-small (q8 ONNX) at a pinned Hugging Face revision, read
# by fetch-model.sh (`make native-model` and the Dockerfile stage `model`). Files are numbered:
# MODEL_FILE_<n> is the path inside the model repository and in the fetched layout, MODEL_SHA256_<n>
# its SHA-256. The same files are what the TypeScript image carries in /app/models.
MODEL_NAME=Xenova/multilingual-e5-small
MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
MODEL_FILE_1=config.json
MODEL_SHA256_1=cb99455288675345e1a4f411438d5d0adbba5fbd3a67ea4fb03c015433b996c1
MODEL_FILE_2=special_tokens_map.json
MODEL_SHA256_2=d05497f1da52c5e09554c0cd874037a083e1dc1b9cfd48034d1c717f1afc07a7
MODEL_FILE_3=tokenizer_config.json
