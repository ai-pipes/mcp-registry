# The pinned native libraries of the `onnx` build: the ONE list of URLs and SHA-256 values.
# Plain NAME=value lines, read by three consumers: the Makefile (`include`), fetch.sh (`.`, so
# `make native-libs` and the Dockerfile stage `go-native` use the same script) and the Go test
# native_pins_test.go, which fails if a pin is repeated anywhere else.
# Platform keys use `_` instead of `-` (linux_arm64) so that they are valid shell names.
#
# ONNX Runtime 1.30.0, CPU: the libraries inside the npm package onnxruntime-node@1.30.0, the very
#   files the TypeScript reference image loads. The exact build is a parity condition.
# libtokenizers 1.27.0: the static library of github.com/daulet/tokenizers, release assets
#   (tarball hash, then the hash of libtokenizers.a inside it).
ORT_NPM_URL=https://registry.npmjs.org/onnxruntime-node/-/onnxruntime-node-1.30.0.tgz
ORT_NPM_SHA256=6e3390d6b783e7be946fad629292799da28d0b42f84856e50d2c1b0383291e75
TOK_BASE_URL=https://github.com/daulet/tokenizers/releases/download/v1.27.0

ORT_MEMBER_darwin_arm64=package/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib
ORT_FILE_darwin_arm64=libonnxruntime.1.30.0.dylib
ORT_SHA_darwin_arm64=685d2be5dba1309c89d3a5324b7fd06a5c42f1a61bfea32d14c4cc28d072121d
TOK_SHA_TGZ_darwin_arm64=fb84b8b2e349a5952767ffe80ccd862fc44084de47f3b0cc3f0b7c9d4e649cf7
TOK_SHA_darwin_arm64=c91ae814afb8fe4f000099972208f60c3aa2d13899a7cd5a31fee2e9e2efbac7

